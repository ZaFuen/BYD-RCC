    function realPowerUpdate(){
        var kwPowerRealValue
        var needleRotation
        var needlePosiX
        var needlePosiY

        if(!hasSelfChecked){
            //自检
            var selfCheckIndex = Math.trunc(selfCheckPowerRealValue)
            //外侧点坐标
            pathArcId.x= positionSelf1XArray[selfCheckIndex]
            pathArcId.y =  positionSelf1YArray[selfCheckIndex]
            //内侧点坐标
            pathLineId.x = positionSelf2XArray[selfCheckIndex]
            pathLineId.y =  positionSelf2YArray[selfCheckIndex]
            needleRotation = rotationSelfArray[selfCheckIndex]
            needleImgId.width = needleSelfWidthArray[selfCheckIndex]
            if(selfCheckPowerRealValue >0){
                pathArcId.reverse = false
            }else{
                pathArcId.reverse = true
            }
        }else{
            var powerIndexValue
            var ratio
            if(DataSource.power === 1001){
                kwPowerRealValue = 0
                powerIndexValue = 0
                ratio = 0
                powerValueTextId.text = 0
            }else{
                //换算成kw的值
                kwPowerRealValue = DataSource.powerUnit === 0x01?DataSource.realPower:(DataSource.realPower/1.34)
                powerIndexValue = Math.trunc(kwPowerRealValue)
                ratio = kwPowerRealValue - powerIndexValue
                powerValueTextId.text = Math.round(DataSource.realPower)
            }

            if(kwPowerRealValue >=0){
                pathArcId.reverse = false
            }else{
                pathArcId.reverse = true
            }
            if(kwPowerRealValue >500){
                pathArcId.x= position1XArray[500]
                pathArcId.y =  position1YArray[500]
                pathLineId.x = position2XArray[500]
                pathLineId.y =  position2YArray[500]
                needlePosiX = position2XArray[500]
                needlePosiY = position2YArray[500]
                needleRotation = rotation1Array[500]
                needleImgId.width = needleWidthArray[500]
            }else{
                if(kwPowerRealValue <=-100){
                    pathArcId.x = position1XArray[500+100]
                    pathArcId.y = position1YArray[500+100]
                    pathLineId.x  = position2XArray[500+100]
                    pathLineId.y  = position2YArray[500+100]
                    needlePosiX = position2XArray[500+100]
                    needlePosiY = position2YArray[500+100]
                    needleRotation = rotation1Array[500+100]
                    needleImgId.width = needleWidthArray[500+100]
                }else if(-100 < kwPowerRealValue && kwPowerRealValue<= -1){
                    pathArcId.x = position1XArray[500-powerIndexValue]-(position1XArray[500-powerIndexValue+1] - position1XArray[500-powerIndexValue])*ratio
                    pathArcId.y = position1YArray[500-powerIndexValue]+(position1YArray[500-powerIndexValue+1] - position1YArray[500-powerIndexValue])*ratio
                    pathLineId.x = position2XArray[500-powerIndexValue]-(position2XArray[500-powerIndexValue+1] - position2XArray[500-powerIndexValue])*ratio
                    pathLineId.y = position2YArray[500-powerIndexValue]+(position2YArray[500-powerIndexValue+1] - position2YArray[500-powerIndexValue])*ratio
                    needlePosiX = position2XArray[500-powerIndexValue]-(position2XArray[500-powerIndexValue+1] - position2XArray[500-powerIndexValue])*ratio
                    needlePosiY = position2YArray[500-powerIndexValue]+(position2YArray[500-powerIndexValue+1] - position2YArray[500-powerIndexValue])*ratio
                    needleRotation = rotation1Array[500-powerIndexValue]+(rotation1Array[500-powerIndexValue+1] - rotation1Array[500-powerIndexValue])*ratio
                    needleImgId.width = needleWidthArray[500-powerIndexValue]+(needleWidthArray[500-powerIndexValue+1] - needleWidthArray[500-powerIndexValue])*ratio
                }else if(-1< kwPowerRealValue && kwPowerRealValue<0){
                    pathArcId.x = position1XArray[powerIndexValue]+(position1XArray[powerIndexValue]-position1XArray[500-(-1)])*ratio
                    pathArcId.y = position1YArray[powerIndexValue]+(position1YArray[powerIndexValue]-position1YArray[500-(-1)])*ratio
                    pathLineId.x = position2XArray[powerIndexValue]+(position2XArray[powerIndexValue]-position2XArray[500-(-1)])*ratio
                    pathLineId.y = position2YArray[powerIndexValue]+(position2YArray[powerIndexValue]-position2YArray[500-(-1)])*ratio
                    needlePosiX = position2XArray[powerIndexValue]+(position2XArray[powerIndexValue]-position2XArray[500-(-1)])*ratio
                    needlePosiY = position2YArray[powerIndexValue]+(position2YArray[powerIndexValue]-position2YArray[500-(-1)])*ratio
                    needleRotation = rotation1Array[powerIndexValue]+(rotation1Array[powerIndexValue]-rotation1Array[500-(-1)])*ratio
                    needleImgId.width = needleWidthArray[powerIndexValue]+(needleWidthArray[powerIndexValue]-needleWidthArray[500-(-1)])*ratio
                }else if(0 <= kwPowerRealValue && kwPowerRealValue <= 500){
                    pathArcId.x = position1XArray[powerIndexValue]+(position1XArray[powerIndexValue+1] - position1XArray[powerIndexValue])*ratio
                    pathArcId.y = position1YArray[powerIndexValue]+(position1YArray[powerIndexValue+1] - position1YArray[powerIndexValue])*ratio
                    pathLineId.x = position2XArray[powerIndexValue]+(position2XArray[powerIndexValue+1] - position2XArray[powerIndexValue])*ratio
                    pathLineId.y = position2YArray[powerIndexValue]+(position2YArray[powerIndexValue+1] - position2YArray[powerIndexValue])*ratio
                    needlePosiX = position2XArray[powerIndexValue]+(position2XArray[powerIndexValue+1] - position2XArray[powerIndexValue])*ratio
                    needlePosiY = position2YArray[powerIndexValue]+(position2YArray[powerIndexValue+1] - position2YArray[powerIndexValue])*ratio
                    needleRotation = rotation1Array[powerIndexValue]+(rotation1Array[powerIndexValue+1] - rotation1Array[powerIndexValue])*ratio
