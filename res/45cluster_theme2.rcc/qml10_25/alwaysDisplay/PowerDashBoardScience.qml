    //        anchors.fill:needleItemId
    //        source:needleItemId
    //        maskSource: powerFillMaskId
    //        visible: (DataSource.power < 1001 && DataSource.power!==0)? true : false
    //    }

    Image{
        id:scale1
        x:110
        y:458
        source: DataSource.dayNightMode === 0x02?"qrc:/images10_25/display_always/dash/science/night/power_scale1.png":"qrc:/images10_25/display_always/dash/science/day/power_scale1.png"
    }
    Image{
        id:scale2
        x:31
        y:180
        source: DataSource.dayNightMode === 0x02?"qrc:/images10_25/display_always/dash/science/night/power_scale2.png":"qrc:/images10_25/display_always/dash/science/day/power_scale2.png"
    }
    Image{
        id:scale3
        x:30
        y:25
        source: DataSource.dayNightMode === 0x02?"qrc:/images10_25/display_always/dash/science/night/power_scale3.png":"qrc:/images10_25/display_always/dash/science/day/power_scale3.png"
    }

    Item{
        id:sciencePowerTextItemId
        width: 545
        height: 546
        anchors.right: parent.right
        Text {
            font.bold:rootItemId.jiacu === 1
            font.family: rootItemId.ziti
            id:powerValueTextId
            anchors.centerIn: parent
            text:"0"
            font.pixelSize: 108
            color: DataSource.dayNightMode === 0x02?"#fefefe":"#000000"
            visible: DataSource.power !== 1001 ? true : false
        }
        Text {
            font.bold:rootItemId.jiacu === 1
            font.family: rootItemId.ziti
            id:powerUnitTextId
            anchors.horizontalCenter:powerValueTextId.horizontalCenter
            anchors.top: powerValueTextId.bottom
            text: DataSource.powerUnit !== 2 ? "kW" : "HP"
            font.pixelSize: 27
            color: DataSource.dayNightMode === 0x02?"#fefefe":"#000000"
            visible: powerValueTextId.visible
        }
    }

    Connections {
        target:DataSource

        function onPluginMsgReceived(id,value){
            if(id === DataSource.SEND_MSG_ID_DASHBOARD_SELFCHECK){
                powerValueTextId.text = 0
                selfCheckPowerRealValue = 0
                selfCheckAnimId.start()
            }else if(id === DataSource.SEND_MSG_ID_THEME_SWITCH_REQUEST){
                if(value === DataSource.THEME_SWITCH_REQUEST_TO_PLAY_HIDE_ANIM){
                    sciencePowerDashOpacityAnimId.start()
                }else if(value === DataSource.THEME_SWITCH_REQUEST_TO_PLAY_DISP_ANIM){
                    needleImgId.opacity = 0
                    sciencePowerMaskId.opacity=0
                    sciencePowerTextItemId.opacity=0
                    sciencePowerDashOpacityShowAnimId.start()
                }else if(value === DataSource.THEME_SWITCH_POWER_OFF_STATE){
                    sciencePowerDashOpacityShowAnimId.stop()
                }
            }
        }

        function onPowerGearChanged(){
            if( DataSource.powerGear !== 3){
                DataSource.realPower = 0
                realPowerUpdate()
                hasSelfChecked = false
            }
        }

        function onPowerUnitChanged(){
            realPowerUpdate()
        }

        function onRealPowerChanged(){
            if(hasSelfChecked){
                realPowerUpdate()
            }
        }
    }


    onSelfCheckPowerRealValueChanged:{
        realPowerUpdate()
    }

    SequentialAnimation {
        id:selfCheckAnimId
        PropertyAnimation {
            target: powerDashRootId
            properties: "selfCheckPowerRealValue"
            to: 18
            duration: CustomStyle.selfCheckAnimationTimer
            easing.type: Easing.InQuad
        }
        PropertyAnimation {
            target: powerDashRootId
            duration: CustomStyle.selfCheckAnimationWaitTimer
        }
        PropertyAnimation {
            target: powerDashRootId
            properties: "selfCheckPowerRealValue"
            to: 0
            duration: CustomStyle.selfCheckAnimationTimer
            easing.type: Easing.OutQuad
        }
        onFinished:{
            hasSelfChecked = true
            if(DataSource.realPower === 0.0){
                DataSource.realPower = DataSource.power
            }
            realPowerUpdate()
        }
    }

    PropertyAnimation{
        id:sciencePowerDashOpacityAnimId
        targets: [sciencePowerMaskId,needleImgId,sciencePowerTextItemId]
        property: "opacity"
        from:1
        to:0
        duration: CustomStyle.themeOpacityChangeTimer
    }

    PropertyAnimation{
        id:sciencePowerDashOpacityShowAnimId
        targets: [sciencePowerMaskId,needleImgId,sciencePowerTextItemId]
        property: "opacity"
        from:0
        to:1
        duration: CustomStyle.themeOpacityChangeTimer
        onFinished: {
            DataSource.changeDashBoard = false
        }
    }
}
