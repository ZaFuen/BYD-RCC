    function realSpeedUpdate(){
        var needleRotation
        var needleWidth
        if(!hasSelfChecked){
            //自检
            var selfCheckIndex = Math.trunc(speedDashRootId.selfCheckSpeedRealValue)
            //外侧点坐标
            pathArcId.x= positionSelf1XArray[selfCheckIndex] -180 //speed_fill.png分辨率由原来的717*524->(717-180)*524，因此减去180
            pathArcId.y =  positionSelf1YArray[selfCheckIndex]

            //内侧点坐标
            pathLineId.x = positionSelf2XArray[selfCheckIndex]-180
            pathLineId.y =  positionSelf2YArray[selfCheckIndex]

            needleWidth = needleWidthSelfArray[selfCheckIndex]
            needleRotation = rotationSelfArray[selfCheckIndex]
        }else{
            var kmSpeedRealValue
            var speedIndexValue
            var ratio
            if(DataSource.speed === -1){
                speedIndexValue = 0
                ratio = 0
                speedValueTextId.text = 0
            }else{
                //换算成km/h值
                if(DataSource.speedUnit === 0x02){
                    kmSpeedRealValue = DataSource.realSpeed*8/5
                }else{
                    kmSpeedRealValue = DataSource.realSpeed
                }
                speedIndexValue = Math.trunc(kmSpeedRealValue)
                ratio = kmSpeedRealValue - speedIndexValue
                speedValueTextId.text = Math.round(DataSource.realSpeed)
            }
            if(speedIndexValue >= 240){
                //外侧点坐标
                pathArcId.x= position1XArray[speedIndexValue] -180
                pathArcId.y =  position1YArray[speedIndexValue]

                //内侧点坐标
                pathLineId.x = position2XArray[speedIndexValue]-180
                pathLineId.y =  position2YArray[speedIndexValue]
                needleWidth = needleWidthArray[speedIndexValue]
                needleRotation = rotation1Array[speedIndexValue]
            }else{
                //外侧点坐标
                pathArcId.x= position1XArray[speedIndexValue]+(position1XArray[speedIndexValue+1] - position1XArray[speedIndexValue])*ratio -180
                pathArcId.y =  position1YArray[speedIndexValue]+(position1YArray[speedIndexValue+1] - position1YArray[speedIndexValue])*ratio

                //内侧点坐标
                pathLineId.x = position2XArray[speedIndexValue]+(position2XArray[speedIndexValue+1] - position2XArray[speedIndexValue])*ratio-180
                pathLineId.y =  position2YArray[speedIndexValue]+(position2YArray[speedIndexValue+1] - position2YArray[speedIndexValue])*ratio

                needleWidth = needleWidthArray[speedIndexValue]+(needleWidthArray[speedIndexValue+1] - needleWidthArray[speedIndexValue])*ratio
                needleRotation = rotation1Array[speedIndexValue]+(rotation1Array[speedIndexValue+1] - rotation1Array[speedIndexValue])*ratio
            }
        }
        needleImgId.x = pathLineId.x+60-3
        needleImgId.y = pathLineId.y+34-needleImgId.height/2+5
        needleImgId.width = needleWidth
        needleImgId.rotation = needleRotation
        //needleImgId.width = Math.sqrt(Math.pow(shapeId.point1X-shapeId.point2X,2)+Math.pow(shapeId.point1Y-shapeId.point2Y,2))
        needleImgId.visible = 1
    }

